        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam actorStyle awesome\n\nactor \&quot;Khách vãng lai\&quot; as Guest\nactor \&quot;Khách hàng\&quot; as Customer\nactor \&quot;Quản trị viên\&quot; as Admin\nactor \&quot;Hệ thống gợi ý\&quot; as RecSys\n\nCustomer --|&gt; Guest\n\nrectangle \&quot;Website bán sách\&quot; {\n  usecase \&quot;Đăng ký\&quot; as UC01\n  usecase \&quot;Đăng nhập\&quot; as UC02\n  usecase \&quot;Tìm kiếm, lọc sách\&quot; as UC03\n  usecase \&quot;Xem chi tiết sách\&quot; as UC04\n  usecase \&quot;Quản lý giỏ hàng\&quot; as UC05\n  usecase \&quot;Đặt hàng\&quot; as UC06\n  usecase \&quot;Theo dõi đơn hàng\&quot; as UC07\n  usecase \&quot;Đánh giá sách\&quot; as UC08\n  usecase \&quot;Xem sách gợi ý\&quot; as UC09\n  usecase \&quot;Quản lý sách và danh mục\&quot; as UC10\n  usecase \&quot;Quản lý đơn hàng\&quot; as UC11\n  usecase \&quot;Quản lý người dùng\&quot; as UC12\n  usecase \&quot;Xem thống kê\&quot; as UC13\n  usecase \&quot;Tính toán gợi ý\&quot; as UC14\n}\n\nGuest --&gt; UC01\nGuest --&gt; UC02\nGuest --&gt; UC03\nGuest --&gt; UC04\n\nCustomer --&gt; UC05\nCustomer --&gt; UC06\nCustomer --&gt; UC07\nCustomer --&gt; UC08\nCustomer --&gt; UC09\n\nAdmin --&gt; UC02\nAdmin --&gt; UC10\nAdmin --&gt; UC11\nAdmin --&gt; UC12\nAdmin --&gt; UC13\n\nUC14 &lt;-- RecSys\n\nnote \&quot;Các use case của Khách hàng và Quản trị viên\\nyêu cầu đã đăng nhập\&quot; as N1\n@enduml\n\n@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam actorStyle awesome\n\nactor \&quot;Khách hàng\&quot; as Customer\n\nrectangle \&quot;Mua hàng\&quot; {\n  usecase \&quot;Thêm sách vào giỏ\&quot; as A1\n  usecase \&quot;Cập nhật số lượng\&quot; as A2\n  usecase \&quot;Xóa sách khỏi giỏ\&quot; as A3\n  usecase \&quot;Đặt hàng\&quot; as B1\n  usecase \&quot;Chọn địa chỉ giao hàng\&quot; as B2\n  usecase \&quot;Thanh toán\&quot; as B3\n  usecase \&quot;Theo dõi đơn hàng\&quot; as C1\n  usecase \&quot;Hủy đơn hàng\&quot; as C2\n  usecase \&quot;Đánh giá sách đã mua\&quot; as D1\n  usecase \&quot;Đăng nhập\&quot; as L\n}\n\nCustomer --&gt; A1\nCustomer --&gt; A2\nCustomer --&gt; A3\nCustomer --&gt; B1\nCustomer --&gt; C1\nCustomer --&gt; D1\n\nA1 ..&gt; L : &lt;&lt;include&gt;&gt;\nB1 ..&gt; L : &lt;&lt;include&gt;&gt;\nB1 ..&gt; B2 : &lt;&lt;include&gt;&gt;\nB1 ..&gt; B3 : &lt;&lt;include&gt;&gt;\nC2 ..&gt; C1 : &lt;&lt;extend&gt;&gt;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="R6EARiI6xujypWqTfbGr-1">
